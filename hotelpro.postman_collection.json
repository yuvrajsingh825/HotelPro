{
  "info": {
    "name": "HotelPro API Collection",
    "_postman_id": "hotelpro-api-v1-collection",
    "description": "Production-ready Postman collection for HotelPro Hotel Booking & Management System REST APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "guestToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1 (555) 123-4567\",\n  \"password\": \"Password@123\",\n  \"confirmPassword\": \"Password@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login Guest",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah.jenkins@example.com\",\n  \"password\": \"GuestPassword@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hotelpro.com\",\n  \"password\": \"AdminPassword@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{guestToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Get All Rooms",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/rooms", "host": ["{{baseUrl}}"], "path": ["rooms"] }
          }
        },
        {
          "name": "Search Available Rooms (Date Overlap Engine)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/rooms/available?checkIn=2026-11-15&checkOut=2026-11-18&guests=2&roomType=All",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "available"],
              "query": [
                { "key": "checkIn", "value": "2026-11-15" },
                { "key": "checkOut", "value": "2026-11-18" },
                { "key": "guests", "value": "2" },
                { "key": "roomType", "value": "All" }
              ]
            }
          }
        },
        {
          "name": "Get Room By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/rooms/:id", "host": ["{{baseUrl}}"], "path": ["rooms", ":id"] }
          }
        },
        {
          "name": "Create Room (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"701\",\n  \"roomType\": \"Suite\",\n  \"description\": \"Grand Skyline Penthouse with private jacuzzi.\",\n  \"price\": 599,\n  \"capacity\": 4,\n  \"bedType\": \"King\",\n  \"amenities\": [\"WiFi\", \"AC\", \"TV\", \"Swimming Pool\", \"Breakfast\"],\n  \"images\": [\"https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1200&q=80\"],\n  \"status\": \"Available\",\n  \"size\": 850,\n  \"floor\": 7\n}"
            },
            "url": { "raw": "{{baseUrl}}/rooms", "host": ["{{baseUrl}}"], "path": ["rooms"] }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"ROOM_ID_HERE\",\n  \"checkIn\": \"2026-11-20\",\n  \"checkOut\": \"2026-11-23\",\n  \"guests\": 2,\n  \"guestName\": \"Sarah Jenkins\",\n  \"guestEmail\": \"sarah.jenkins@example.com\",\n  \"guestPhone\": \"+1 (555) 234-5678\",\n  \"specialRequests\": \"Quiet high-floor room preferred.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{guestToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/my", "host": ["{{baseUrl}}"], "path": ["bookings", "my"] }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{guestToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/:id/cancel", "host": ["{{baseUrl}}"], "path": ["bookings", ":id", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Process Mock Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"BOOKING_ID_HERE\",\n  \"cardNumber\": \"4242 4242 4242 4242\",\n  \"cardHolder\": \"Sarah Jenkins\",\n  \"expiry\": \"12/28\",\n  \"cvv\": \"888\",\n  \"paymentMethod\": \"Demo Visa\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Admin Dashboard Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "Get All Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/bookings", "host": ["{{baseUrl}}"], "path": ["admin", "bookings"] }
          }
        }
      ]
    }
  ]
}
