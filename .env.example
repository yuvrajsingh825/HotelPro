# ============================================================
# HotelPro – Environment Variables Configuration
# ============================================================

# Backend Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB Connection String
# Leave empty to automatically use Embedded In-Memory MongoDB (Zero-configuration startup)
# Or provide your local MongoDB URI or MongoDB Atlas connection string:
# MONGO_URI=mongodb://localhost:27017/hotelpro
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hotelpro
MONGO_URI=

# JSON Web Token Configuration
JWT_SECRET=hotelpro_super_secure_jwt_secret_key_2026_production
JWT_EXPIRE=7d

# Frontend Base URL (Client Port)
CLIENT_URL=http://localhost:3000
